<view class="screen with-tabs">
  <text class="page-title">配置中心</text>
  <navigator class="card config-card" wx:for="{{entries}}" wx:key="key" url="{{item.url}}">
    <view class="config-icon {{item.tone}}"><image src="/assets/icons/{{item.icon}}.svg" mode="aspectFit" /></view>
    <view class="config-info">
      <text class="config-label">{{item.title}}</text>
      <text wx:if="{{item.meta}}" class="muted">{{item.meta}}</text>
    </view>
    <text class="config-arrow">›</text>
  </navigator>
  <navigator wx:if="{{canManageFamily}}" class="card config-card" url="/pages/family/index">
    <view class="config-icon blue"><image src="/assets/icons/user.svg" mode="aspectFit" /></view>
    <view class="config-info">
      <text class="config-label">家庭成员</text>
      <text class="muted">生成邀请码、添加或移除成员</text>
    </view>
    <text class="config-arrow">›</text>
  </navigator>
  <button bindtap="logout">退出登录</button>
</view>
