<view class="screen {{withTabs ? 'with-tabs' : ''}}">
  <view class="record-header">
    <text class="page-title">{{title}}</text>
    <view class="record-controls">
      <view wx:if="{{snapshots}}" class="view-toggle">
        <button wx:for="{{snapshotModes}}" wx:key="*this" size="mini" class="{{modeIndex === index && !date ? 'selected' : ''}}" data-index="{{index}}" bindtap="changeMode">{{item}}</button>
      </view>
      <button size="mini" class="primary" bindtap="edit">{{goals ? '新增目标' : '新增记录'}}</button>
    </view>
  </view>
  <view class="card" wx:if="{{snapshots}}">
    <view class="row"><picker mode="date" value="{{date || targetDate}}" bindchange="filterDate"><view>{{date || '按日期筛选'}} ›</view></picker>
      <button wx:if="{{date}}" size="mini" bindtap="clearDate">清除</button></view>
    <view class="row"><picker mode="date" value="{{targetDate}}" bindchange="setTargetDate"><view>复制到 {{targetDate}} ›</view></picker>
      <button size="mini" bindtap="copy" disabled="{{busy}}">复制最近快照</button></view>
    <button wx:if="{{date}}" class="danger" size="mini" bindtap="removeDate" disabled="{{busy}}">删除当日全部快照</button>
  </view>
  <view class="card gold-card" wx:if="{{golds}}">
    <text class="title">黄金持仓</text>
    <view class="row" wx:for="{{goldSummary}}" wx:key="name"><text>{{item.name}}</text><text>{{item.value}}</text></view>
    <view class="actions"><button size="mini" bindtap="refreshPrice" disabled="{{busy}}">更新金价</button><button size="mini" bindtap="openConfig">设置金价接口</button></view>
    <view class="field" wx:if="{{configOpen}}"><input password="{{true}}" value="{{config}}" bindinput="inputConfig" placeholder="金价接口令牌" />
      <button size="mini" bindtap="saveConfig" disabled="{{busy}}">保存令牌</button></view>
  </view>
  <view class="actions" wx:if="{{assetTypes}}"><button size="mini" bindtap="importAssetTypes" disabled="{{busy}}">从微信聊天导入 CSV</button></view>
  <view class="error" wx:if="{{error}}">{{error}} <text bindtap="load">重试</text></view>
  <view class="card muted" wx:if="{{loading}}">正在加载</view>
  <view class="card muted" wx:elif="{{!error && !count}}">暂无记录</view>
  <view class="card hero hero-green" wx:if="{{goals && rows.length}}">
    <view class="muted">{{rows[0].title}}</view>
    <view>年度目标</view>
    <text class="amount">{{rows[0].amount}}</text>
    <text class="muted">{{rows[0].detail}}</text>
  </view>
  <view class="card {{snapshots ? 'snapshot-card' : ''}} {{item.debt ? 'debt' : ''}}" wx:for="{{rows}}" wx:key="id">
    <view class="record-main">
      <view class="record-content">
        <view wx:if="{{snapshots}}" class="record-icon"><image src="/assets/icons/wallet.svg" mode="aspectFit" /></view>
        <view>
          <view class="record-title">{{item.title}}</view>
          <view class="record-tags" wx:if="{{snapshots}}">
            <text class="record-tag {{tagIndex === 0 ? 'date-tag' : ''}}" wx:for="{{item.tags}}" wx:for-item="tag" wx:for-index="tagIndex" wx:key="*this">{{tag}}</text>
          </view>
          <view wx:elif="{{item.detail}}" class="muted">{{item.detail}}</view>
        </view>
      </view>
      <text class="record-amount">{{item.amount}}</text>
    </view>
    <view class="actions record-actions">
      <button size="mini" class="link" data-id="{{item.id}}" bindtap="edit">编辑</button>
      <button wx:if="{{item.toggle}}" class="link" size="mini" data-id="{{item.id}}" data-enabled="{{item.enabled}}" bindtap="toggle" disabled="{{busy}}">{{item.enabled ? '停用' : '启用'}}</button>
      <button size="mini" class="link danger" data-id="{{item.id}}" bindtap="remove" disabled="{{busy}}">删除</button>
    </view>
  </view>
</view>
