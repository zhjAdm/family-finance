page {
  min-height: 100%;
  background-color: #f0f4ff;
  background-image:
    radial-gradient(ellipse at top left, rgba(120, 180, 255, 0.35), transparent 52%),
    radial-gradient(ellipse at bottom right, rgba(180, 140, 255, 0.25), transparent 55%),
    radial-gradient(ellipse at 88% 14%, rgba(255, 180, 140, 0.2), transparent 36%),
    radial-gradient(ellipse at 74% 46%, rgba(130, 220, 180, 0.22), transparent 44%),
    linear-gradient(135deg, #f0f4ff 0%, #e8ecf8 50%, #f5f0ff 100%);
  background-attachment: fixed;
  color: #4e5969;
  font: 14px -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.screen { padding: 16px; }
.with-tabs { padding-bottom: calc(76px + env(safe-area-inset-bottom, 0px)); }
.page-title { display: block; margin-bottom: 16px; color: #1d2129; font-size: 18px; font-weight: 700; }
.card {
  box-sizing: border-box;
  margin: 0 0 12px;
  padding: 16px;
  background: rgba(255, 255, 255, 0.45);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-radius: 14px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.8);
}

.hero {
  padding: 20px 16px;
  color: #fff;
  background: linear-gradient(135deg, rgba(64, 158, 255, 0.85), rgba(107, 203, 255, 0.85));
  border-color: rgba(255, 255, 255, 0.25);
  box-shadow: 0 12px 40px rgba(64, 158, 255, 0.2);
}
.hero .muted { color: rgba(255, 255, 255, 0.9); }
.hero .title { color: #fff; }
.hero-green { background: linear-gradient(135deg, rgba(103, 194, 58, 0.85), rgba(149, 212, 117, 0.85)); }
.gold-card { background: linear-gradient(135deg, #fff8e1, #ffecb3); border-color: rgba(255, 179, 0, 0.2); color: #5d4600; }
.gold-card .title { color: #5d4600; }

.amount { display: block; margin: 4px 0 8px; font-size: 28px; font-weight: 700; word-break: break-word; }
.title { display: block; margin-bottom: 8px; color: #1d2129; font-size: 15px; font-weight: 600; }
.muted { color: #86909c; font-size: 13px; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 0; }
.actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0; }
.actions button { margin: 0; }

button {
  background: #fff;
  color: #4e5969;
  border: 1px solid #dcdfe6;
  border-radius: 10px;
  font-size: 14px;
}
button::after { border: 0; }
button[size="mini"] { font-size: 12px; padding: 0 12px; line-height: 28px; }
button.primary { background: #409eff; border-color: #409eff; color: #fff; box-shadow: 0 4px 16px rgba(64, 158, 255, 0.25); }
button.danger, .error { color: #f56c6c; }
button.link { background: transparent; border-color: transparent; color: #409eff; }
button.link.danger { color: #f56c6c; }
button[disabled] { opacity: 0.6; }

.field { margin-bottom: 16px; }
.field input, .field picker, .field textarea, .selector {
  display: block;
  box-sizing: border-box;
  min-height: 34px;
  padding: 7px 10px;
  border: 1px solid rgba(0, 0, 0, 0.08);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.45);
}
.field input, .field picker, .field textarea { width: 100%; margin-top: 4px; }
.field textarea { height: 84px; }
.error { margin: 10px 0; }
.bar { height: 6px; border-radius: 4px; background: rgba(64, 158, 255, 0.12); }
.bar view { height: 100%; border-radius: 4px; background: linear-gradient(90deg, #409eff, #79bbff); }
