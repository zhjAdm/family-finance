<view class="bottom-hub">
  <view class="hub-item {{selected === item.name ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="name"
    data-name="{{item.name}}" bindtap="switchTab" role="button" aria-label="{{item.label}}">
    <image class="hub-icon" src="/assets/icons/{{item.icon}}{{selected === item.name ? '-active' : ''}}.svg" mode="aspectFit" />
    <text>{{item.label}}</text>
  </view>
</view>
